# Dufaka-Go behind nginx — example server block.
#
# Copy to /etc/nginx/sites-available/shop.conf (or conf.d/), adjust server_name,
# certificate paths and the upstream address, then `nginx -t && systemctl reload nginx`.
#
# Dufaka-Go trusts X-Real-IP / X-Forwarded-For / X-Forwarded-Proto only from a
# trusted proxy: loopback by default (nginx on the same host, proxying to
# 127.0.0.1). If nginx runs on another machine or in another container, start
# Dufaka-Go with the proxy's address or network listed, e.g.
#   DUFAKA_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5
# and never expose the Dufaka-Go port directly to the internet.

server {
    listen 80;
    listen [::]:80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    # Card imports and admin forms are small; raise only if you upload large files.
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8080;   # DUFAKA_ADDR
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # The buyer's address as nginx saw it (orders.buy_ip, rate limits).
        proxy_set_header X-Real-IP         $remote_addr;
        # Dufaka-Go reads exactly one header for the client address: X-Real-IP by
        # default (overwritten above with $remote_addr, so clients cannot forge it).
        # A proxy that only appends X-Forwarded-For needs
        # DUFAKA_REAL_IP_HEADER=X-Forwarded-For (then only the last entry counts).
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # "https" here makes Dufaka-Go send HSTS.
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
